{%- comment %}
The words. Forecast on: the forecast line, with or without the drawings.
Only the drawings: "works all day" on one. The sarcastic line is the same
for every screen (flavour_line): the blocks pick it for what's on screen.
{%- endcomment %}
{%- assign w_fact = '' -%}
{%- assign w_flavour = flavour_line -%}
{%- if forecast_on and fact_line != '' -%}
  {%- assign w_fact = fact_line -%}
{%- elsif visual_forecast -%}
  {%- assign w_fact = panel_fact -%}
{%- endif -%}
{%- comment %}
No texts file with the forecast wordings (a device that has this markup
but not yet the texts polling URL, rollout step 1): the old one-line tip,
from the copies the transitional markup carries.
{%- endcomment %}
{%- if w_fact == '' and w_flavour == '' and texts.facts == nil and show_future_suggestions == 'on' and today_tip != '' -%}
  {%- assign w_flavour = today_tip -%}
{%- endif -%}
{%- assign has_words = false -%}
{%- if w_fact != '' or w_flavour != '' -%}{%- assign has_words = true -%}{%- endif -%}
{%- assign n = 1 -%}
{%- if visual_forecast -%}{%- assign n = panel_n -%}{%- endif -%}
{%- if is_error %}
<div class="layout layout--row portrait:layout--col layout--center gap">
  <img class="image image--contain h--[100cqh] w--max-[40cqw] portrait:h--[60cqh] portrait:w--max-[100cqw]" src="{{ sprite_url }}" alt="Error">
  <div class="content content--center text--center stretch-x content--large" data-content-limiter="true">
    <p>{{ error_headline }}</p>
  </div>
</div>
{%- elsif n == 1 %}
{%- if has_words -%}
  {%- assign c_outer = 'layout layout--row portrait:layout--col gap' -%}
  {%- assign c_wrap = 'flex flex--col gap--none w--[36cqw] h--[100cqh] portrait:w--[100cqw] portrait:h--auto portrait:stretch' -%}
  {%- assign c_image = 'image image--contain image-dither w--[52cqw] h--[100cqh] portrait:w--[100cqw] portrait:h--auto portrait:stretch portrait:h--min-[40cqh]' -%}
  {%- assign c_words = 'w--[60cqw] portrait:w--[96cqw] content--base lg:content--large' -%}
{%- else -%}
  {%- assign c_outer = 'layout layout--col gap--small' -%}{%- assign c_wrap = '' -%}{%- assign c_image = 'image image--contain image-dither aspect--1/1 w--[100cqw] h--min-[40cqh]' -%}
{%- endif -%}
<div class="{{ c_outer }}">
  {%- if c_wrap != '' %}<div class="{{ c_wrap }}">{%- endif %}
  <img class="{{ c_image }}" src="{{ sprite_url }}" onerror="this.onerror=null;this.src='{{ fallback_sprite_url }}'" alt="Outfit">
  {%- if c_wrap != '' %}</div>{%- endif %}
  {%- if has_words %}
  <div class="content content--center text--center {{ c_words }}" data-wtw="words">
    {%- if w_fact != '' %}<p class="font--bold">{{ w_fact }}</p>{%- endif %}
    {%- if w_flavour != '' %}<p>{{ w_flavour }}</p>{%- endif %}
  </div>
  {%- endif %}
</div>
{%- else %}
{%- if n == 2 -%}
  {%- if w_fact != '' -%}
    {%- assign c_outer = 'layout layout--col gap--small' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[40cqw]' -%}{%- assign c_image = 'w--[54cqw] h--max-[42cqh]' -%}{%- assign c_words = 'w--[92cqw] content--small lg:content--base' -%}
  {%- elsif has_words -%}
    {%- assign c_outer = 'layout layout--col gap--small' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[40cqw]' -%}{%- assign c_image = 'w--[54cqw] h--max-[54cqh]' -%}{%- assign c_words = 'w--[92cqw] content--small lg:content--large' -%}
  {%- else -%}
    {%- assign c_outer = 'layout layout--col gap--small' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[40cqw]' -%}{%- assign c_image = 'w--[54cqw] h--max-[74cqh]' -%}{%- assign c_words = 'w--[92cqw] content--small lg:content--large' -%}
  {%- endif -%}
{%- else -%}
  {%- if w_fact != '' -%}
    {%- assign c_outer = 'layout layout--col gap--small' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[28cqw]' -%}{%- assign c_image = 'w--[38cqw] h--max-[42cqh]' -%}{%- assign c_words = 'w--[92cqw] content--small lg:content--base' -%}
  {%- elsif has_words -%}
    {%- assign c_outer = 'layout layout--col gap--small' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[28cqw]' -%}{%- assign c_image = 'w--[38cqw] h--max-[54cqh]' -%}{%- assign c_words = 'w--[92cqw] content--small lg:content--large' -%}
  {%- else -%}
    {%- assign c_outer = 'layout layout--col gap--small' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[28cqw]' -%}{%- assign c_image = 'w--[38cqw] h--max-[74cqh]' -%}{%- assign c_words = 'w--[92cqw] content--small lg:content--large' -%}
  {%- endif -%}
{%- endif -%}
<div class="{{ c_outer }}">
  <div class="{{ c_row }}" data-wtw="panels">
    {%- for slug in panel_slug_list %}
    <div class="flex flex--col gap--small {{ c_panel }}">
      <img class="image image--contain image-dither aspect--1/1 {{ c_image }}" src="{{ sprite_base_url }}{{ slug }}.png" alt="{{ slug }}">
      <span class="label text--center mx--1 lg:label--large{% if forloop.first %} font--bold label--underline{% endif %}">{{ panel_label_list[forloop.index0] }}</span>
    </div>
    {%- endfor %}
  </div>
  {%- if has_words %}
  <div class="content content--center text--center {{ c_words }}" data-wtw="words">
    {%- if w_fact != '' %}<p class="font--bold">{{ w_fact }}</p>{%- endif %}
    {%- if w_flavour != '' %}<p>{{ w_flavour }}</p>{%- endif %}
  </div>
  {%- endif %}
</div>
{%- endif %}

{%- if show_bottom_bar == 'on' -%}
  <div class="title_bar">
    <span class="title">What to Wear</span>
    <span class="instance">{{ location_label }}</span>
  </div>
{%- endif -%}
