{%- comment %} The words: the forecast in words, or Visual Forecast's. {%- endcomment %}
{%- assign w_fact = '' -%}
{%- assign w_flavour = '' -%}
{%- if visual_forecast -%}
  {%- assign w_fact = panel_fact -%}
  {%- assign w_flavour = panel_flavour -%}
{%- elsif show_future_suggestions == 'on' and fact_line != '' -%}
  {%- assign w_fact = fact_line -%}
  {%- assign w_flavour = flavour_line -%}
{%- endif -%}
{%- assign has_words = false -%}
{%- if w_fact != '' or w_flavour != '' -%}{%- assign has_words = true -%}{%- endif -%}
{%- assign n = 1 -%}
{%- if visual_forecast -%}{%- assign n = panel_n -%}{%- endif -%}
{%- if is_error %}
<div class="layout layout--row portrait:layout--col layout--center gap">
  <img class="image image--contain h--[100cqh] w--max-[40cqw] portrait:h--[60cqh] portrait:w--max-[100cqw]" src="{{ sprite_url }}" alt="Error">
  <div class="content content--center text--center stretch-x content--large" data-content-limiter="true">
    <p>{{ error_headline }}</p>
  </div>
</div>
{%- elsif n == 1 %}
{%- if has_words -%}
  {%- assign c_outer = 'layout layout--row portrait:layout--col gap' -%}
  {%- assign c_wrap = 'flex flex--col gap--none w--[36cqw] h--[100cqh] portrait:w--[100cqw] portrait:h--auto portrait:stretch' -%}
  {%- assign c_image = 'image image--contain image-dither w--[52cqw] h--[100cqh] portrait:w--[100cqw] portrait:h--auto portrait:stretch portrait:h--min-[40cqh]' -%}
  {%- assign c_words = 'w--[60cqw] portrait:w--[96cqw] content--large lg:content--xlarge' -%}
{%- else -%}
  {%- assign c_outer = 'layout layout--col gap--small' -%}{%- assign c_wrap = '' -%}{%- assign c_image = 'image image--contain image-dither aspect--1/1 w--[100cqw] h--min-[40cqh]' -%}
{%- endif -%}
<div class="{{ c_outer }}">
  {%- if c_wrap != '' %}<div class="{{ c_wrap }}">{%- endif %}
  <img class="{{ c_image }}" src="{{ sprite_url }}" onerror="this.onerror=null;this.src='{{ fallback_sprite_url }}'" alt="Outfit">
  {%- if c_wrap != '' %}</div>{%- endif %}
  {%- if has_words %}
  <div class="content content--center text--center {{ c_words }}" data-wtw="words">
    {%- if w_fact != '' %}<p class="font--bold">{{ w_fact }}</p>{%- endif %}
    {%- if w_flavour != '' %}<p>{{ w_flavour }}</p>{%- endif %}
  </div>
  {%- endif %}
</div>
{%- else %}
{%- if n == 2 -%}
  {%- if has_words -%}
    {%- assign c_outer = 'layout layout--row portrait:layout--col gap' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[26cqw] portrait:w--[40cqw]' -%}{%- assign c_image = 'w--[34cqw] h--max-[84cqh] portrait:w--[54cqw] portrait:h--max-[62cqh]' -%}{%- assign c_words = 'w--[34cqw] portrait:w--[92cqw] content--large lg:content--xlarge' -%}
  {%- else -%}
    {%- assign c_outer = 'layout layout--col gap--small' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[40cqw]' -%}{%- assign c_image = 'w--[54cqw] h--max-[78cqh]' -%}{%- assign c_words = 'w--[92cqw] content--large lg:content--xlarge' -%}
  {%- endif -%}
{%- else -%}
  {%- if has_words -%}
    {%- assign c_outer = 'layout layout--row portrait:layout--col gap' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[18cqw] portrait:w--[28cqw]' -%}{%- assign c_image = 'w--[24cqw] h--max-[84cqh] portrait:w--[38cqw] portrait:h--max-[62cqh]' -%}{%- assign c_words = 'w--[34cqw] portrait:w--[92cqw] content--large lg:content--xlarge' -%}
  {%- else -%}
    {%- assign c_outer = 'layout layout--col gap--small' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[28cqw]' -%}{%- assign c_image = 'w--[38cqw] h--max-[78cqh]' -%}{%- assign c_words = 'w--[92cqw] content--large lg:content--xlarge' -%}
  {%- endif -%}
{%- endif -%}
<div class="{{ c_outer }}">
  <div class="{{ c_row }}" data-wtw="panels">
    {%- for slug in panel_slug_list %}
    <div class="flex flex--col gap--small {{ c_panel }}">
      <img class="image image--contain image-dither aspect--1/1 {{ c_image }}" src="{{ sprite_base_url }}{{ slug }}.png" alt="{{ slug }}">
      <span class="label text--center mx--1 lg:label--xlarge">{% if forloop.first %}<b><u>{{ panel_label_list[0] }}</u></b>{% else %}{{ panel_label_list[forloop.index0] }}{% endif %}</span>
    </div>
    {%- endfor %}
  </div>
  {%- if has_words %}
  <div class="content content--center text--center {{ c_words }}" data-wtw="words">
    {%- if w_fact != '' %}<p class="font--bold">{{ w_fact }}</p>{%- endif %}
    {%- if w_flavour != '' %}<p>{{ w_flavour }}</p>{%- endif %}
  </div>
  {%- endif %}
</div>
{%- endif %}

{%- if show_bottom_bar == 'on' -%}
  <div class="title_bar">
    <span class="title">What to Wear</span>
    <span class="instance">{{ location_label }}</span>
  </div>
{%- endif -%}
