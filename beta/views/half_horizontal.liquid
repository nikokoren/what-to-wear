{%- comment %}
The words. Forecast on: the forecast line, with or without the drawings.
Only the drawings: "works all day" on one. The sarcastic line is the same
for every screen (flavour_line): the blocks pick it for what's on screen.
{%- endcomment %}
{%- assign w_fact = '' -%}
{%- assign w_flavour = flavour_line -%}
{%- if forecast_on and fact_line != '' -%}
  {%- assign w_fact = fact_line -%}
{%- elsif visual_forecast -%}
  {%- assign w_fact = panel_fact -%}
{%- endif -%}
{%- comment %}
No texts file with the forecast wordings (a device that has this markup
but not yet the texts polling URL, rollout step 1): the old one-line tip,
from the copies the transitional markup carries.
{%- endcomment %}
{%- if w_fact == '' and w_flavour == '' and texts.facts == nil and show_future_suggestions == 'on' and today_tip != '' -%}
  {%- assign w_flavour = today_tip -%}
{%- endif -%}
{%- assign has_words = false -%}
{%- if w_fact != '' or w_flavour != '' -%}{%- assign has_words = true -%}{%- endif -%}
{%- assign n = 1 -%}
{%- if visual_forecast -%}{%- assign n = panel_n -%}{%- endif -%}
{%- if is_error %}
<div class="layout layout--row portrait:layout--col layout--center gap">
  <img class="image image--contain h--[100cqh] w--max-[40cqw] portrait:h--[60cqh] portrait:w--max-[100cqw]" src="{{ sprite_url }}" alt="Error">
  <div class="content content--center text--center stretch-x content--large" data-content-limiter="true">
    <p>{{ error_headline }}</p>
  </div>
</div>
{%- elsif evening_on %}
{%- assign w_fact = ev_fact -%}{%- assign w_flavour = ev_joke -%}
{%- assign has_words = false -%}
{%- if w_fact != '' or w_flavour != '' -%}{%- assign has_words = true -%}{%- endif -%}
{%- assign ev_n = ev_slug_list | size -%}
{%- if ev_tonight_slug == '' %}
{%- if has_words -%}
  {%- assign c_outer = 'layout layout--row portrait:layout--col gap' -%}
  {%- assign c_wrap = 'flex flex--col gap--none w--[40cqw] h--[100cqh] portrait:w--[100cqw] portrait:h--auto portrait:stretch' -%}
  {%- assign c_image = 'image image--contain image-dither w--[46cqw] h--[94cqh] portrait:w--[100cqw] portrait:h--auto portrait:stretch portrait:h--min-[34cqh]' -%}
  {%- assign c_words = 'w--[56cqw] portrait:w--[96cqw] content--large lg:content--xlarge' -%}
{%- else -%}
  {%- assign c_outer = 'layout layout--col gap--small' -%}{%- assign c_wrap = '' -%}{%- assign c_image = 'image image--contain image-dither aspect--1/1 w--[100cqw] h--min-[34cqh]' -%}
{%- endif -%}
<div class="{{ c_outer }}" data-wtw="evening">
  {%- if c_wrap != '' %}<div class="{{ c_wrap }}">{%- endif %}
  <span class="label label--inverted lg:label--xlarge" data-wtw="tomorrow">{{ ev_tag }}</span>
  <img class="{{ c_image }}" src="{{ sprite_base_url }}{{ ev_slug_list | first }}.png" alt="{{ ev_slug_list | first }}">
  {%- if c_wrap != '' %}</div>{%- endif %}
  {%- if has_words %}
  <div class="content content--center text--center {{ c_words }}" data-wtw="words">
    {%- if w_fact != '' %}<p class="font--bold">{{ w_fact }}</p>{%- endif %}
    {%- if w_flavour != '' %}<p>{{ w_flavour }}</p>{%- endif %}
  </div>
  {%- endif %}
</div>
{%- else -%}
{%- assign n = ev_n | plus: 1 -%}
{%- if n == 2 -%}
  {%- if w_fact != '' -%}
    {%- assign c_outer = 'layout layout--row portrait:layout--col gap' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[25cqw] portrait:w--[47cqw]' -%}{%- assign c_image = 'w--[26cqw] h--max-[78cqh] portrait:w--[51cqw] portrait:h--max-[42cqh]' -%}{%- assign c_words = 'w--[46cqw] portrait:w--[92cqw] content--base lg:content--large' -%}
  {%- elsif has_words -%}
    {%- assign c_outer = 'layout layout--row portrait:layout--col gap' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[30cqw] portrait:w--[47cqw]' -%}{%- assign c_image = 'w--[32cqw] h--max-[78cqh] portrait:w--[51cqw] portrait:h--max-[56cqh]' -%}{%- assign c_words = 'w--[34cqw] portrait:w--[92cqw] content--large lg:content--xlarge' -%}
  {%- else -%}
    {%- assign c_outer = 'layout layout--col gap--small' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[47cqw]' -%}{%- assign c_image = 'w--[51cqw] h--max-[72cqh]' -%}{%- assign c_words = 'w--[92cqw] content--large lg:content--xlarge' -%}
  {%- endif -%}
{%- else -%}
  {%- if w_fact != '' -%}
    {%- assign c_outer = 'layout layout--row portrait:layout--col gap' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[17cqw] portrait:w--[31cqw]' -%}{%- assign c_image = 'w--[16cqw] h--max-[78cqh] portrait:w--[32cqw] portrait:h--max-[42cqh]' -%}{%- assign c_words = 'w--[46cqw] portrait:w--[92cqw] content--base lg:content--large' -%}
  {%- elsif has_words -%}
    {%- assign c_outer = 'layout layout--row portrait:layout--col gap' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[20cqw] portrait:w--[31cqw]' -%}{%- assign c_image = 'w--[20cqw] h--max-[78cqh] portrait:w--[32cqw] portrait:h--max-[56cqh]' -%}{%- assign c_words = 'w--[34cqw] portrait:w--[92cqw] content--large lg:content--xlarge' -%}
  {%- else -%}
    {%- assign c_outer = 'layout layout--col gap--small' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[31cqw]' -%}{%- assign c_image = 'w--[32cqw] h--max-[72cqh]' -%}{%- assign c_words = 'w--[92cqw] content--large lg:content--xlarge' -%}
  {%- endif -%}
{%- endif -%}
<div class="{{ c_outer }}" data-wtw="evening">
  <div class="{{ c_row }}" data-wtw="panels">
    <div class="flex flex--col flex--center-x gap--small">
      <span class="label label--outline lg:label--xlarge">{{ texts.evening.tonight }}</span>
      <div class="flex flex--col gap--small {{ c_panel }}">
        <img class="image image--contain image-dither aspect--3/4 {{ c_image }}" src="{{ sprite_base_url }}{{ ev_tonight_slug }}.png" alt="{{ ev_tonight_slug }}">
        <span class="label text--center mx--1 lg:label--xlarge">{{ ev_tonight_label }}</span>
      </div>
    </div>
    <div class="divider divider--v"></div>
    <div class="flex flex--col flex--center-x gap--small">
      <span class="label label--inverted lg:label--xlarge" data-wtw="tomorrow">{{ ev_tag }}</span>
      <div class="{{ c_row }}">
      {%- for slug in ev_slug_list %}
      <div class="flex flex--col gap--small {{ c_panel }}">
        <img class="image image--contain image-dither aspect--3/4 {{ c_image }}" src="{{ sprite_base_url }}{{ slug }}.png" alt="{{ slug }}">
        <span class="label text--center mx--1 lg:label--xlarge">{{ ev_label_list[forloop.index0] }}</span>
      </div>
      {%- endfor %}
      </div>
    </div>
  </div>
  {%- if has_words %}
  <div class="content content--center text--center {{ c_words }}" data-wtw="words">
    {%- if w_fact != '' %}<p class="font--bold">{{ w_fact }}</p>{%- endif %}
    {%- if w_flavour != '' %}<p>{{ w_flavour }}</p>{%- endif %}
  </div>
  {%- endif %}
</div>
{%- endif %}
{%- elsif n == 1 %}
{%- if has_words -%}
  {%- assign c_outer = 'layout layout--row portrait:layout--col gap' -%}
  {%- assign c_wrap = 'flex flex--col gap--none w--[40cqw] h--[100cqh] portrait:w--[100cqw] portrait:h--auto portrait:stretch' -%}
  {%- assign c_image = 'image image--contain image-dither w--[46cqw] h--[100cqh] portrait:w--[100cqw] portrait:h--auto portrait:stretch portrait:h--min-[40cqh]' -%}
  {%- assign c_words = 'w--[56cqw] portrait:w--[96cqw] content--large lg:content--xlarge' -%}
{%- else -%}
  {%- assign c_outer = 'layout layout--col gap--small' -%}{%- assign c_wrap = '' -%}{%- assign c_image = 'image image--contain image-dither aspect--1/1 w--[100cqw] h--min-[40cqh]' -%}
{%- endif -%}
<div class="{{ c_outer }}">
  {%- if c_wrap != '' %}<div class="{{ c_wrap }}">{%- endif %}
  <img class="{{ c_image }}" src="{{ sprite_url }}" onerror="this.onerror=null;this.src='{{ fallback_sprite_url }}'" alt="Outfit">
  {%- if c_wrap != '' %}</div>{%- endif %}
  {%- if has_words %}
  <div class="content content--center text--center {{ c_words }}" data-wtw="words">
    {%- if w_fact != '' %}<p class="font--bold">{{ w_fact }}</p>{%- endif %}
    {%- if w_flavour != '' %}<p>{{ w_flavour }}</p>{%- endif %}
  </div>
  {%- endif %}
</div>
{%- else %}
{%- if n == 2 -%}
  {%- if w_fact != '' -%}
    {%- assign c_outer = 'layout layout--row portrait:layout--col gap' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[25cqw] portrait:w--[47cqw]' -%}{%- assign c_image = 'w--[26cqw] h--max-[84cqh] portrait:w--[51cqw] portrait:h--max-[48cqh]' -%}{%- assign c_words = 'w--[46cqw] portrait:w--[92cqw] content--base lg:content--large' -%}
  {%- elsif has_words -%}
    {%- assign c_outer = 'layout layout--row portrait:layout--col gap' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[30cqw] portrait:w--[47cqw]' -%}{%- assign c_image = 'w--[32cqw] h--max-[84cqh] portrait:w--[51cqw] portrait:h--max-[62cqh]' -%}{%- assign c_words = 'w--[34cqw] portrait:w--[92cqw] content--large lg:content--xlarge' -%}
  {%- else -%}
    {%- assign c_outer = 'layout layout--col gap--small' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[47cqw]' -%}{%- assign c_image = 'w--[51cqw] h--max-[78cqh]' -%}{%- assign c_words = 'w--[92cqw] content--large lg:content--xlarge' -%}
  {%- endif -%}
{%- else -%}
  {%- if w_fact != '' -%}
    {%- assign c_outer = 'layout layout--row portrait:layout--col gap' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[17cqw] portrait:w--[31cqw]' -%}{%- assign c_image = 'w--[16cqw] h--max-[84cqh] portrait:w--[32cqw] portrait:h--max-[48cqh]' -%}{%- assign c_words = 'w--[46cqw] portrait:w--[92cqw] content--base lg:content--large' -%}
  {%- elsif has_words -%}
    {%- assign c_outer = 'layout layout--row portrait:layout--col gap' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[20cqw] portrait:w--[31cqw]' -%}{%- assign c_image = 'w--[20cqw] h--max-[84cqh] portrait:w--[32cqw] portrait:h--max-[62cqh]' -%}{%- assign c_words = 'w--[34cqw] portrait:w--[92cqw] content--large lg:content--xlarge' -%}
  {%- else -%}
    {%- assign c_outer = 'layout layout--col gap--small' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[31cqw]' -%}{%- assign c_image = 'w--[32cqw] h--max-[78cqh]' -%}{%- assign c_words = 'w--[92cqw] content--large lg:content--xlarge' -%}
  {%- endif -%}
{%- endif -%}
<div class="{{ c_outer }}">
  <div class="{{ c_row }}" data-wtw="panels">
    {%- for slug in panel_slug_list %}
    <div class="flex flex--col gap--small {{ c_panel }}">
      <img class="image image--contain image-dither aspect--3/4 {{ c_image }}" src="{{ sprite_base_url }}{{ slug }}.png" alt="{{ slug }}">
      <span class="label text--center mx--1 lg:label--xlarge{% if forloop.first %} font--bold label--underline{% endif %}">{{ panel_label_list[forloop.index0] }}</span>
    </div>
    {%- endfor %}
  </div>
  {%- if has_words %}
  <div class="content content--center text--center {{ c_words }}" data-wtw="words">
    {%- if w_fact != '' %}<p class="font--bold">{{ w_fact }}</p>{%- endif %}
    {%- if w_flavour != '' %}<p>{{ w_flavour }}</p>{%- endif %}
  </div>
  {%- endif %}
</div>
{%- endif %}

{%- if show_bottom_bar == 'on' -%}
  <div class="title_bar">
    <span class="title">What to Wear</span>
    <span class="instance">{{ location_label }}</span>
  </div>
{%- endif -%}
