{%- comment %}
The words. Forecast on: the forecast line, with or without the drawings.
Only the drawings: "works all day" on one. The sarcastic line is the same
for every screen (flavour_line): the blocks pick it for what's on screen.
{%- endcomment %}
{%- assign w_fact = '' -%}
{%- assign w_flavour = flavour_line -%}
{%- if forecast_on and fact_line != '' -%}
  {%- assign w_fact = fact_line -%}
{%- elsif visual_forecast -%}
  {%- assign w_fact = panel_fact -%}
{%- endif -%}
{%- comment %}
No texts file with the forecast wordings (a device that has this markup
but not yet the texts polling URL, rollout step 1): the old one-line tip,
from the copies the transitional markup carries.
{%- endcomment %}
{%- if w_fact == '' and w_flavour == '' and texts.facts == nil and show_future_suggestions == 'on' and today_tip != '' -%}
  {%- assign w_flavour = today_tip -%}
{%- endif -%}
{%- assign has_words = false -%}
{%- if w_fact != '' or w_flavour != '' -%}{%- assign has_words = true -%}{%- endif -%}
{%- assign n = 1 -%}
{%- if visual_forecast -%}{%- assign n = panel_n -%}{%- endif -%}
{%- if is_error %}
<div class="layout layout--col layout--center">
  <div class="richtext richtext--center gap w--max-[100cqw]">
    <img class="image image--contain h--[60cqh]" src="{{ sprite_url }}" alt="Error">
    <div class="content content--center text--center w--max-[100cqw] content--base lg:content--large" data-content-limiter="true">
      <p>{{ error_message }}</p>
    </div>
  </div>
</div>
{%- elsif evening_on %}
{%- assign ev_words = false -%}
{%- if ev_fact != '' or ev_joke != '' -%}{%- assign ev_words = true -%}{%- endif -%}
{%- if ev_tonight_slug != '' and true == false -%}{%- assign ev_words = false -%}{%- endif -%}
{%- if ev_words -%}{%- assign ev_h = 46 -%}{%- else -%}{%- assign ev_h = 60 -%}{%- endif -%}
<div class="layout layout--col gap--small" data-wtw="evening">
  <div class="flex flex--row gap--small">
  {%- if ev_tonight_slug != '' %}
    <div class="flex flex--col flex--center-x gap--small w--[32cqw]">
      <span class="label label--outline">{{ texts.evening.tonight }}</span>
      <div class="flex flex--col gap--small w--[30cqw]"><img class="image image--contain image-dither aspect--3/4 w--[31cqw] h--max-[{{ ev_h }}cqh]" src="{{ sprite_base_url }}{{ ev_tonight_slug }}.png" alt="{{ ev_tonight_slug }}"><span class="label text--center lg:label--xlarge">{{ ev_tonight_label }}</span></div>
    </div>
    <div class="divider divider--v"></div>
  {%- endif %}
    <div class="flex flex--col flex--center-x gap--small">
      <span class="label label--inverted" data-wtw="tomorrow">{{ ev_tag }}</span>
      <div class="flex flex--row gap--none">
      {%- for slug in ev_slug_list %}
      {%- if ev_tonight_slug != '' or forloop.first %}
        <div class="flex flex--col gap--small w--[30cqw]"><img class="image image--contain image-dither aspect--3/4 w--[31cqw] h--max-[{{ ev_h }}cqh]" src="{{ sprite_base_url }}{{ slug }}.png" alt="{{ slug }}"><span class="label text--center lg:label--xlarge">{{ ev_label_list[forloop.index0] }}</span></div>
      {%- endif %}
      {%- endfor %}
      </div>
    </div>
  </div>
  {%- if ev_words %}
  <div class="content content--center text--center w--[94cqw] content--base lg:content--large" data-wtw="words">
    {%- if ev_fact != '' %}<p class="font--bold">{{ ev_fact }}</p>{%- endif %}
    {%- if ev_joke != '' %}<p>{{ ev_joke }}</p>{%- endif %}
  </div>
  {%- endif %}
</div>
{%- elsif n == 1 %}
{%- assign c_outer = 'layout layout--col gap--small' -%}{%- assign c_wrap = '' -%}{%- assign c_image = 'image image--contain image-dither aspect--1/1 w--[100cqw] h--min-[40cqh]' -%}{%- assign c_words = 'w--[96cqw] content--xlarge lg:content--xxlarge' -%}
<div class="{{ c_outer }}">
  {%- if c_wrap != '' %}<div class="{{ c_wrap }}">{%- endif %}
  <img class="{{ c_image }}" src="{{ sprite_url }}" onerror="this.onerror=null;this.src='{{ fallback_sprite_url }}'" alt="Outfit">
  {%- if c_wrap != '' %}</div>{%- endif %}
  {%- if has_words %}
  <div class="content content--center text--center {{ c_words }}" data-wtw="words">
    {%- if w_fact != '' %}<p class="font--bold">{{ w_fact }}</p>{%- endif %}
    {%- if w_flavour != '' %}<p>{{ w_flavour }}</p>{%- endif %}
  </div>
  {%- endif %}
</div>
{%- else %}
{%- if n == 2 -%}
  {%- if w_fact != '' -%}
    {%- assign c_outer = 'layout layout--col gap--small' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[47cqw]' -%}{%- assign c_image = 'w--[51cqw] h--max-[50cqh]' -%}{%- assign c_words = 'w--[92cqw] content--large lg:content--xlarge' -%}
  {%- elsif has_words -%}
    {%- assign c_outer = 'layout layout--col gap--small' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[47cqw]' -%}{%- assign c_image = 'w--[51cqw] h--max-[66cqh]' -%}{%- assign c_words = 'w--[92cqw] content--xlarge lg:content--xxlarge' -%}
  {%- else -%}
    {%- assign c_outer = 'layout layout--col gap--small' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[47cqw]' -%}{%- assign c_image = 'w--[51cqw] h--max-[80cqh]' -%}{%- assign c_words = 'w--[92cqw] content--xlarge lg:content--xxlarge' -%}
  {%- endif -%}
{%- else -%}
  {%- if w_fact != '' -%}
    {%- assign c_outer = 'layout layout--col gap--small' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[31cqw]' -%}{%- assign c_image = 'w--[32cqw] h--max-[50cqh]' -%}{%- assign c_words = 'w--[92cqw] content--large lg:content--xlarge' -%}
  {%- elsif has_words -%}
    {%- assign c_outer = 'layout layout--col gap--small' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[31cqw]' -%}{%- assign c_image = 'w--[32cqw] h--max-[66cqh]' -%}{%- assign c_words = 'w--[92cqw] content--xlarge lg:content--xxlarge' -%}
  {%- else -%}
    {%- assign c_outer = 'layout layout--col gap--small' -%}{%- assign c_row = 'flex flex--row gap--none' -%}{%- assign c_panel = 'w--[31cqw]' -%}{%- assign c_image = 'w--[32cqw] h--max-[80cqh]' -%}{%- assign c_words = 'w--[92cqw] content--xlarge lg:content--xxlarge' -%}
  {%- endif -%}
{%- endif -%}
<div class="{{ c_outer }}">
  <div class="{{ c_row }}" data-wtw="panels">
    {%- for slug in panel_slug_list %}
    <div class="flex flex--col gap--small {{ c_panel }}">
      <img class="image image--contain image-dither aspect--3/4 {{ c_image }}" src="{{ sprite_base_url }}{{ slug }}.png" alt="{{ slug }}">
      <span class="label text--center mx--1 lg:label--xlarge{% if forloop.first %} font--bold label--underline{% endif %}">{{ panel_label_list[forloop.index0] }}</span>
    </div>
    {%- endfor %}
  </div>
  {%- if has_words %}
  <div class="content content--center text--center {{ c_words }}" data-wtw="words">
    {%- if w_fact != '' %}<p class="font--bold">{{ w_fact }}</p>{%- endif %}
    {%- if w_flavour != '' %}<p>{{ w_flavour }}</p>{%- endif %}
  </div>
  {%- endif %}
</div>
{%- endif %}

{%- if show_bottom_bar == 'on' -%}
  <div class="title_bar">
    <span class="title">What to Wear</span>
    <span class="instance">{{ location_label }}</span>
  </div>
{%- endif -%}
