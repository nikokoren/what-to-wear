    {%- if wants_whenp and texts_ok -%}
      {%- assign pgap = precip_idx | minus: now_index -%}
      {%- assign ph = local_hour | plus: pgap -%}
      {%- if ph > 23 -%}{%- assign ph = 23 -%}{%- endif -%}
      {%- assign pb = HOUR_BUCKET[ph] | plus: 0 -%}
      {%- if pb == now_bucket and pgap >= 1 and pgap <= 3 -%}
        {%- assign pgi = pgap | minus: 1 -%}
        {%- assign when_precip = RELATIVE[pgi] -%}
      {%- else -%}
        {%- assign when_precip = BUCKETS[pb] -%}
      {%- endif -%}
    {%- endif -%}

    {%- if temp_scenario != '' -%}
      {%- assign scenario = temp_scenario -%}
    {%- else -%}
      {%- assign scenario = 'perfect' -%}
    {%- endif -%}

  {%- else -%}
    {%- assign scenario = 'perfect' -%}
    {%- assign precip_scenario = '' -%}
  {%- endif -%}

{%- endif -%}

{%- assign active_theme = '' -%}
{%- if today_md == '12-31' or today_md == '01-01' -%}{%- assign active_theme = 'ny' -%}{%- endif -%}
{%- if today_md == '02-02' -%}{%- assign active_theme = 'ghd' -%}{%- endif -%}
{%- if today_md == '03-14' -%}{%- assign active_theme = 'pi' -%}{%- endif -%}
{%- assign ey = today_year | plus: 0 -%}
{%- assign ea = ey | modulo: 19 -%}
{%- assign eb = ey | divided_by: 100 -%}
{%- assign ec = ey | modulo: 100 -%}
{%- assign ed = eb | divided_by: 4 -%}
{%- assign ee = eb | modulo: 4 -%}
{%- assign ef = eb | plus: 8 | divided_by: 25 -%}
{%- assign eg = eb | minus: ef | plus: 1 | divided_by: 3 -%}
{%- assign eh = ea | times: 19 | plus: eb | minus: ed | minus: eg | plus: 15 | modulo: 30 -%}
{%- assign ei = ec | divided_by: 4 -%}
{%- assign ek = ec | modulo: 4 -%}
{%- assign el = ee | times: 2 | plus: 32 | plus: ei | plus: ei | minus: eh | minus: ek | modulo: 7 -%}
{%- assign eh11 = eh | times: 11 -%}
{%- assign em = el | times: 22 | plus: ea | plus: eh11 | divided_by: 451 -%}
{%- assign em7 = em | times: 7 -%}
{%- assign en_ = eh | plus: el | minus: em7 | plus: 114 -%}
{%- assign easter_month = en_ | divided_by: 31 -%}
{%- assign easter_day = en_ | modulo: 31 | plus: 1 -%}
{%- assign easter_md = '0' | append: easter_month | append: '-' -%}
