{%- comment %}
What to Wear, beta. Built by tools/build_beta.py from src/shared.liquid and
prototypes/; the comments explaining it are there. Don't edit by hand.
{%- endcomment %}
{%- assign MIN_DELTA = 2 -%}
{%- assign RAIN_LOW = 25 -%}
{%- assign RAIN_HIGH = 50 -%}
{%- assign DAY_END_HOUR = 21 -%}
{%- assign TIP_BUDGET = 165 -%}

{%- assign BAND_EDGES = '-5,5,12,18,24,30,34' -%}
{%- assign BAND_NAMES = 'bundled,coat,jacket,sweater,tee_pants,tee_shorts,heat,extreme_heat' -%}
{%- assign SNOW_OUTFITS = ',bundled,coat,jacket,' -%}

{%- assign sprite_base_url  = 'https://raw.githubusercontent.com/nikokoren/what-to-wear/refs/heads/main/sprites/' -%}
{%- assign error_sprite_url = 'https://raw.githubusercontent.com/nikokoren/what-to-wear/refs/heads/main/404.png' -%}

{%- assign location_label_raw = trmnl.plugin_settings.custom_fields_values.location_label | default: '' -%}
{%- assign show_future_suggestions_raw = trmnl.plugin_settings.custom_fields_values.show_future_suggestions -%}
{%- if show_future_suggestions_raw == nil or show_future_suggestions_raw == '' -%}{%- assign show_future_suggestions_raw = 'yes' -%}{%- endif -%}
{%- assign language_raw = trmnl.plugin_settings.custom_fields_values.language | default: 'en' -%}
{%- assign sarcasm_level_raw = trmnl.plugin_settings.custom_fields_values.sarcasm_level | default: '10' -%}
{%- assign show_bottom_bar = trmnl.plugin_settings.custom_fields_values.show_bottom_bar | default: 'on' -%}
{%- assign temp_preference_raw = trmnl.plugin_settings.custom_fields_values.temp_preference | default: '0' -%}

{%- assign temp_shift = 0 -%}
{%- assign tp_check = temp_preference_raw | strip -%}
{%- if tp_check == '-4' or tp_check == '-2' or tp_check == '2' or tp_check == '4' -%}
  {%- assign temp_shift = tp_check | plus: 0 -%}
{%- endif -%}

{%- assign show_future_suggestions = 'on' -%}
{%- assign sfs_check = show_future_suggestions_raw | append: '' | downcase | strip -%}
{%- if sfs_check == 'no' or sfs_check == 'false' or sfs_check == '0' -%}
  {%- assign show_future_suggestions = 'off' -%}
{%- endif -%}

{%- assign lang = language_raw | downcase | strip -%}
{%- if lang == '' -%}
  {%- assign lang = 'en' -%}
{%- endif -%}

{%- assign sarcasm_level = '0' -%}
{%- assign sarc_check = sarcasm_level_raw | strip -%}
{%- if sarc_check == '10' or sarc_check == '11' -%}
  {%- assign sarcasm_level = sarc_check -%}
{%- endif -%}

{%- assign location_label = location_label_raw -%}

{%- assign texts = nil -%}
{%- if IDX_0 -%}
  {%- assign cw = IDX_0.current -%}
  {%- assign h = IDX_0.hourly -%}
  {%- assign wx_offset = IDX_0.utc_offset_seconds -%}
  {%- assign texts = IDX_1 -%}
{%- else -%}
  {%- assign cw = current -%}
  {%- assign h = hourly -%}
  {%- assign wx_offset = utc_offset_seconds -%}
{%- endif -%}

{%- assign texts_ok = false -%}
{%- if texts.meta.code -%}
  {%- assign texts_ok = true -%}
{%- endif -%}

{%- assign now_time = cw.time -%}

{%- assign is_error = false -%}
{%- assign error_message = '' -%}
{%- assign error_headline = '' -%}

{%- if cw == nil -%}
  {%- assign is_error = true -%}
  {%- assign error_key = 'error_current' -%}
{%- elsif h == nil -%}
  {%- assign is_error = true -%}
  {%- assign error_key = 'error_hourly' -%}
{%- endif -%}

{%- assign has_location = false -%}
{%- assign lat_lon_set = trmnl.plugin_settings.custom_fields_values.lat_lon | default: '' | strip -%}
{%- assign latitude_set = trmnl.plugin_settings.custom_fields_values.latitude | default: '' | strip -%}
{%- if lat_lon_set != '' or latitude_set != '' -%}
  {%- assign has_location = true -%}
{%- endif -%}
{%- if is_error and has_location == false -%}
  {%- assign error_key = 'error_location' -%}
{%- endif -%}

{%- if is_error -%}
  {%- if texts_ok -%}
    {%- assign error_message = texts.ui[error_key] -%}
    {%- assign error_headline = texts.ui.error_short -%}
    {%- if error_key == 'error_location' and texts.ui.error_location_short -%}
      {%- assign error_headline = texts.ui.error_location_short -%}
    {%- endif -%}
  {%- endif -%}
    {%- if error_message == '' or error_message == nil -%}
    {%- if lang == 'de' -%}
      {%- if error_key == 'error_location' -%}
        {%- assign error_message = 'Kein Ort eingestellt. Öffne die Einstellungen und wähle einen aus.' -%}
        {%- assign error_headline = 'Kein Ort eingestellt' -%}
      {%- else -%}
        {%- if error_key == 'error_current' -%}
          {%- assign error_message = 'Wetterdaten konnten nicht abgerufen werden. Bitte versuche es später erneut.' -%}
        {%- else -%}
          {%- assign error_message = 'Wettervorhersage konnte nicht geladen werden. Bitte versuche es später erneut.' -%}
        {%- endif -%}
        {%- assign error_headline = 'Wetterdaten konnten nicht gelesen werden' -%}
      {%- endif -%}
    {%- else -%}
      {%- if error_key == 'error_location' -%}
        {%- assign error_message = 'No location set. Open this plugin’s settings and choose one.' -%}
        {%- assign error_headline = 'No location set' -%}
      {%- else -%}
        {%- if error_key == 'error_current' -%}
          {%- assign error_message = 'Unable to retrieve weather data. Please try again later.' -%}
        {%- else -%}
          {%- assign error_message = 'Unable to load forecast data. Please try again later.' -%}
        {%- endif -%}
        {%- assign error_headline = 'Could not read weather data' -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{%- assign local_hour = 12 -%}
{%- assign today_md = '01-01' -%}
{%- assign today_year = '2026' -%}

{%- assign epoch_utc = trmnl.system.timestamp_utc | default: 0 | plus: 0 -%}
{%- assign day_offset = trmnl.user.utc_offset | default: 0 | plus: 0 -%}
{%- if wx_offset != nil -%}
  {%- assign day_offset = wx_offset | plus: 0 -%}
{%- endif -%}
{%- assign local_secs = epoch_utc | plus: day_offset -%}

{%- if now_time -%}
  {%- assign local_hour = now_time | slice: 11, 2 | plus: 0 -%}
  {%- assign today_md = now_time | slice: 5, 5 -%}
  {%- assign today_year = now_time | slice: 0, 4 -%}
{%- else -%}
  {%- assign local_hour = local_secs | divided_by: 3600 | modulo: 24 -%}
  {%- assign today_md = local_secs | date: '%m-%d' -%}
  {%- assign today_year = local_secs | date: '%Y' -%}
{%- endif -%}

{%- assign local_days = local_secs | divided_by: 86400 -%}

{%- assign RAIN_CODES = ',51,53,55,56,57,61,63,65,66,67,80,81,82,95,96,99,' -%}
{%- assign SNOW_CODES = ',71,73,75,77,85,86,' -%}

{%- assign temp_c = 0 -%}
{%- assign wmo = 0 -%}
{%- assign is_now_precip = 0 -%}
{%- assign heat_danger = false -%}
{%- assign stop_idx = -1 -%}
{%- assign is_now_snow = 0 -%}
{%- assign band = 'mild' -%}
{%- assign band_rank = 5 -%}
{%- assign weather_slug = '' -%}

{%- assign has_future_window = false -%}
{%- assign max_temp_future = 0 -%}
{%- assign max_temp_idx = 0 -%}
{%- assign peak_rain = 0 -%}
{%- assign first_rain_idx = -1 -%}
{%- assign first_snow_idx = -1 -%}
{%- assign future_has_snow = false -%}
{%- assign rain_qualifies = false -%}

{%- assign scenario = 'perfect' -%}
{%- assign temp_scenario = '' -%}
{%- assign precip_scenario = '' -%}
{%- assign when_temp = '' -%}
{%- assign when_temp2 = '' -%}
{%- assign when_precip = '' -%}
{%- assign when_temp_bucket = -1 -%}
{%- assign is_arc = false -%}
{%- assign garment_n = '' -%}
{%- assign garment_a = '' -%}

{%- if is_error == false -%}

    {%- assign temp_c = cw.apparent_temperature | default: cw.temperature_2m | default: 0 | plus: 0 -%}
  {%- assign wmo = cw.weather_code | default: 0 | plus: 0 -%}

  {%- assign wmo_probe = ',' | append: wmo | append: ',' -%}
  {%- if RAIN_CODES contains wmo_probe -%}
    {%- assign is_now_precip = 1 -%}
  {%- elsif SNOW_CODES contains wmo_probe -%}
    {%- assign is_now_precip = 1 -%}
    {%- assign is_now_snow = 1 -%}
  {%- endif -%}

    {%- assign band_edge_list = BAND_EDGES | split: ',' -%}
  {%- assign band_name_list = BAND_NAMES | split: ',' -%}

  {%- assign temp_banded = temp_c | plus: temp_shift -%}
  {%- assign band_rank = 8 -%}
  {%- for edge in band_edge_list -%}
    {%- assign edge_c = edge | plus: 0 -%}
    {%- if temp_banded <= edge_c -%}
      {%- assign band_rank = forloop.index -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign band_idx = band_rank | minus: 1 -%}
  {%- assign band = band_name_list[band_idx] -%}

    {%- assign precip_suffix = 'dry' -%}
  {%- if is_now_snow == 1 -%}
    {%- assign precip_suffix = 'snow' -%}
  {%- elsif is_now_precip == 1 -%}
    {%- assign precip_suffix = 'rain' -%}
  {%- endif -%}
  {%- assign weather_slug = band | append: '_' | append: precip_suffix -%}

    {%- assign now_index = -1 -%}
  {%- if now_time and h.time -%}
    {%- assign now_stamp = now_time | slice: 0, 13 -%}
    {%- for t in h.time -%}
      {%- if t contains now_stamp -%}
        {%- assign now_index = forloop.index0 -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if now_index < 0 -%}
    {%- assign now_index = local_hour -%}
  {%- endif -%}

    {%- assign cutoff_hour = DAY_END_HOUR -%}
  {%- assign min_cutoff = local_hour | plus: 3 -%}
  {%- if min_cutoff > cutoff_hour -%}
    {%- assign cutoff_hour = min_cutoff -%}
  {%- endif -%}
  {%- if cutoff_hour > 23 -%}
    {%- assign cutoff_hour = 23 -%}
  {%- endif -%}

  {%- assign temps = h.apparent_temperature -%}
  {%- assign temps_air = h.temperature_2m -%}
  {%- assign probs = h.precipitation_probability -%}
  {%- assign codes = h.weather_code -%}

  {%- if temps != nil and probs != nil and cutoff_hour > local_hour -%}
    {%- assign h_count = temps | size | default: 0 -%}
    {%- assign last_index = h_count | minus: 1 -%}
    {%- assign span = cutoff_hour | minus: local_hour -%}
    {%- assign start_index = now_index | plus: 1 -%}
    {%- assign end_index = now_index | plus: span -%}
    {%- if end_index > last_index -%}
      {%- assign end_index = last_index -%}
    {%- endif -%}

    {%- if start_index <= end_index -%}
      {%- assign has_future_window = true -%}

            {%- assign held_lo_csv = '' -%}
      {%- assign rank_hi_csv = '' -%}
      {%- assign rank_lo_csv = '' -%}
            {%- assign max_temp_future = temp_c -%}
      {%- assign max_temp_idx = now_index -%}
      {%- assign up_rank = band_rank -%}
      {%- for i in (start_index..end_index) -%}
        {%- assign tv = temps[i] | default: temps_air[i] | default: temp_c | plus: 0 -%}
        {%- assign held_hi = tv -%}
        {%- assign held_lo = tv -%}
        {%- assign j = i | plus: 1 -%}
        {%- if j <= last_index -%}
          {%- assign tn = temps[j] | default: temps_air[j] | default: tv | plus: 0 -%}
          {%- if tn < held_hi -%}{%- assign held_hi = tn -%}{%- endif -%}
          {%- if tn > held_lo -%}{%- assign held_lo = tn -%}{%- endif -%}
        {%- endif -%}

                {%- assign hi_banded = held_hi | plus: temp_shift -%}
        {%- assign lo_banded = held_lo | plus: temp_shift -%}
        {%- assign r_hi = 1 -%}
        {%- assign r_lo = 1 -%}
        {%- for edge in band_edge_list -%}
          {%- assign edge_c = edge | plus: 0 -%}
          {%- if hi_banded > edge_c -%}{%- assign r_hi = forloop.index | plus: 1 -%}{%- endif -%}
          {%- if lo_banded > edge_c -%}{%- assign r_lo = forloop.index | plus: 1 -%}{%- endif -%}
        {%- endfor -%}

        {%- if held_hi > max_temp_future -%}
          {%- assign max_temp_future = held_hi -%}
          {%- assign max_temp_idx = i -%}
          {%- assign up_rank = r_hi -%}
        {%- endif -%}

                {%- unless forloop.first -%}
          {%- assign held_lo_csv = held_lo_csv | append: ',' -%}
          {%- assign rank_hi_csv = rank_hi_csv | append: ',' -%}
          {%- assign rank_lo_csv = rank_lo_csv | append: ',' -%}
        {%- endunless -%}
        {%- assign held_lo_csv = held_lo_csv | append: held_lo -%}
        {%- assign rank_hi_csv = rank_hi_csv | append: r_hi -%}
        {%- assign rank_lo_csv = rank_lo_csv | append: r_lo -%}
      {%- endfor -%}
      {%- assign held_lo_list = held_lo_csv | split: ',' -%}
      {%- assign rank_hi_list = rank_hi_csv | split: ',' -%}
      {%- assign rank_lo_list = rank_lo_csv | split: ',' -%}

            {%- assign shorts_idx = -1 -%}
      {%- assign shorts_hours = 0 -%}
      {%- for r in rank_hi_list -%}
        {%- assign rv = r | plus: 0 -%}
        {%- if rv >= 6 -%}
          {%- assign shorts_hours = shorts_hours | plus: 1 -%}
          {%- if shorts_idx < 0 -%}{%- assign shorts_idx = start_index | plus: forloop.index0 -%}{%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign shorts_early = false -%}
      {%- assign shorts_swing = false -%}
      {%- if band_rank <= 4 and shorts_hours >= 3 -%}
        {%- assign shorts_swing = true -%}
      {%- endif -%}
      {%- if band_rank == 5 and shorts_idx >= 0 -%}
        {%- assign cool_hours = shorts_idx | minus: now_index -%}
        {%- if cool_hours <= shorts_hours or shorts_hours >= 3 -%}
          {%- assign shorts_early = true -%}
        {%- endif -%}
      {%- endif -%}

            {%- assign pants_swing = false -%}
      {%- assign pants_idx = -1 -%}
      {%- assign cold_hours = 0 -%}
      {%- assign scorch_hours = 0 -%}
      {%- for r in rank_lo_list -%}
        {%- assign rv = r | plus: 0 -%}
        {%- assign hv = rank_hi_list[forloop.index0] | plus: 0 -%}
        {%- if rv <= 2 -%}
          {%- assign cold_hours = cold_hours | plus: 1 -%}
          {%- if pants_idx < 0 -%}{%- assign pants_idx = start_index | plus: forloop.index0 -%}{%- endif -%}
        {%- endif -%}
        {%- if hv >= 8 -%}{%- assign scorch_hours = scorch_hours | plus: 1 -%}{%- endif -%}
      {%- endfor -%}
            {%- assign legs_short = shorts_early -%}
      {%- if band_rank >= 6 -%}{%- assign legs_short = true -%}{%- endif -%}
      {%- if legs_short and cold_hours >= 3 -%}
        {%- assign pants_swing = true -%}
        {%- assign shorts_early = false -%}
      {%- endif -%}
      {%- if scorch_hours >= 2 or band_rank >= 8 -%}{%- assign heat_danger = true -%}{%- endif -%}

            {%- assign dip_min = temp_c -%}
      {%- assign dip_rank = band_rank -%}
      {%- assign after_min = max_temp_future -%}
      {%- assign after_rank = up_rank -%}
      {%- assign after_idx = max_temp_idx -%}
      {%- for v in held_lo_list -%}
        {%- assign hr = start_index | plus: forloop.index0 -%}
        {%- assign vv = v | plus: 0 -%}
        {%- if hr < max_temp_idx -%}
          {%- if vv < dip_min -%}
            {%- assign dip_min = vv -%}
            {%- assign dip_rank = rank_lo_list[forloop.index0] | plus: 0 -%}
          {%- endif -%}
        {%- elsif hr > max_temp_idx -%}
          {%- if vv < after_min -%}
            {%- assign after_min = vv -%}
            {%- assign after_idx = hr -%}
            {%- assign after_rank = rank_lo_list[forloop.index0] | plus: 0 -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

            {%- assign run_len = 0 -%}
      {%- assign best_run = 0 -%}
      {%- assign dry_run = 0 -%}
      {%- assign gap_found = false -%}
      {%- assign back_run = 0 -%}
      {%- assign back_best = 0 -%}
      {%- assign back_peak = 0 -%}
      {%- assign back_idx = -1 -%}
            {%- assign stop_idx = -1 -%}
      {%- assign stop_try = -1 -%}
      {%- for i in (start_index..end_index) -%}
        {%- assign pv = probs[i] | default: 0 | plus: 0 -%}
        {%- if pv > peak_rain -%}
          {%- assign peak_rain = pv -%}
        {%- endif -%}
        {%- if pv >= RAIN_LOW -%}
          {%- assign run_len = run_len | plus: 1 -%}
          {%- if run_len > best_run -%}
            {%- assign best_run = run_len -%}
          {%- endif -%}
          {%- if first_rain_idx < 0 -%}
            {%- assign first_rain_idx = i -%}
          {%- endif -%}
        {%- else -%}
          {%- assign run_len = 0 -%}
        {%- endif -%}

        {%- if gap_found -%}
          {%- if pv > back_peak -%}
            {%- assign back_peak = pv -%}
          {%- endif -%}
          {%- if pv >= RAIN_LOW -%}
            {%- assign back_run = back_run | plus: 1 -%}
            {%- if back_run > back_best -%}
              {%- assign back_best = back_run -%}
            {%- endif -%}
            {%- if back_idx < 0 -%}
              {%- assign back_idx = i -%}
            {%- endif -%}
          {%- else -%}
            {%- assign back_run = 0 -%}
          {%- endif -%}
        {%- elsif pv < RAIN_LOW -%}
          {%- assign dry_run = dry_run | plus: 1 -%}
          {%- if dry_run == 1 -%}{%- assign stop_try = i -%}{%- endif -%}
          {%- if dry_run >= 2 -%}
            {%- assign gap_found = true -%}
            {%- assign stop_idx = stop_try -%}
          {%- endif -%}
        {%- else -%}
          {%- assign dry_run = 0 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if best_run >= 2 or peak_rain >= RAIN_HIGH -%}
        {%- assign rain_qualifies = true -%}
      {%- endif -%}
      {%- assign rain_returns = false -%}
      {%- if back_best >= 2 or back_peak >= RAIN_HIGH -%}
        {%- assign rain_returns = true -%}
      {%- endif -%}

            {%- if codes != nil -%}
        {%- for i in (start_index..end_index) -%}
          {%- assign c_probe = ',' | append: codes[i] | append: ',' -%}
          {%- if SNOW_CODES contains c_probe -%}
            {%- assign future_has_snow = true -%}
            {%- assign first_snow_idx = i -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}

  {%- if has_future_window -%}

        {%- assign GARMENTS_N = texts.garments.n -%}
    {%- assign GARMENTS_A = texts.garments.a -%}
    {%- assign WKEYS = 'w_scarf,w_coat,w_jacket,w_hoodie' | split: ',' -%}
    {%- assign CKEYS = 'c_scarf,c_coat,c_jacket,c_hoodie' | split: ',' -%}

        {%- assign garment_n = '' -%}
    {%- assign garment_a = '' -%}
    {%- if band_rank <= 4 and texts_ok -%}
      {%- assign gi = band_rank | minus: 1 -%}
      {%- assign garment_n = GARMENTS_N[gi] -%}
      {%- assign garment_a = GARMENTS_A[gi] -%}
    {%- endif -%}

        {%- assign delta_up = max_temp_future | minus: temp_c -%}
    {%- assign warm_key = '' -%}
    {%- assign warm_removable = false -%}
    {%- if delta_up >= MIN_DELTA and up_rank > band_rank -%}
      {%- assign same_class = false -%}
      {%- if band_rank >= 5 and band_rank <= 6 and up_rank >= 5 and up_rank <= 6 -%}
        {%- assign same_class = true -%}
      {%- endif -%}
      {%- unless same_class -%}
        {%- if band_rank <= 4 -%}
          {%- assign wi = band_rank | minus: 1 -%}
          {%- assign warm_key = WKEYS[wi] -%}
          {%- assign warm_removable = true -%}
        {%- elsif up_rank >= 7 -%}
                    {%- assign warm_key = 'w_water' -%}
        {%- endif -%}
      {%- endunless -%}
    {%- endif -%}

        {%- assign dip_key = '' -%}
    {%- assign delta_dip = temp_c | minus: dip_min -%}
    {%- if delta_dip >= MIN_DELTA and dip_rank < band_rank -%}
      {%- assign same_class = false -%}
      {%- if dip_rank >= 5 and dip_rank <= 6 and band_rank >= 5 and band_rank <= 6 -%}
        {%- assign same_class = true -%}
      {%- endif -%}
      {%- unless same_class -%}
        {%- if dip_rank <= 4 -%}
          {%- assign ci = dip_rank | minus: 1 -%}
          {%- assign dip_key = CKEYS[ci] -%}
        {%- else -%}
          {%- assign dip_key = 'c_relief' -%}
        {%- endif -%}
      {%- endunless -%}
    {%- endif -%}

    {%- assign after_key = '' -%}
    {%- assign delta_after = max_temp_future | minus: after_min -%}
    {%- if delta_after >= MIN_DELTA and after_rank < up_rank -%}
      {%- assign same_class = false -%}
      {%- if after_rank >= 5 and after_rank <= 6 and up_rank >= 5 and up_rank <= 6 -%}
        {%- assign same_class = true -%}
      {%- endif -%}
      {%- unless same_class -%}
        {%- if after_rank <= 4 -%}
          {%- assign ci = after_rank | minus: 1 -%}
          {%- assign after_key = CKEYS[ci] -%}
        {%- else -%}
          {%- assign after_key = 'c_relief' -%}
        {%- endif -%}
      {%- endunless -%}
    {%- endif -%}

        {%- assign off_rank = band_rank | plus: 1 -%}
    {%- if band_rank == 5 -%}
      {%- assign off_rank = 7 -%}
    {%- endif -%}
    {%- assign back_rank = band_rank -%}
    {%- if after_rank > band_rank -%}
      {%- assign back_rank = after_rank -%}
    {%- endif -%}
    {%- assign warm_idx = -1 -%}
    {%- assign dip_idx = -1 -%}
    {%- assign bring_idx = -1 -%}
    {%- assign back_on_idx = -1 -%}
