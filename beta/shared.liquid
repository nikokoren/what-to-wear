{%- if is_error == false and show_future_suggestions == 'on' and texts_ok -%}

  {%- assign temp_lib_key = 'temp_' | append: sarcasm_level -%}
  {%- assign temp_lib = texts[temp_lib_key] -%}
  {%- assign t_arr = temp_lib[scenario] -%}

  {%- if t_arr -%}
    {%- assign n = t_arr | size -%}
    {%- if n > 0 -%}
      {%- assign idx = local_days | modulo: n -%}
      {%- assign temp_clause = t_arr[idx] -%}
            {%- assign need_plain = false -%}
      {%- if when_temp == '' or when_temp == nil -%}
        {%- assign need_plain = true -%}
      {%- endif -%}
      {%- if is_arc and when_temp2 == '' -%}
