    {%- endif -%}

    {%- assign precip_lib_key = 'precip_' | append: sarcasm_level -%}
    {%- assign precip_lib = texts[precip_lib_key] -%}
    {%- assign p_arr = precip_lib[p_key] -%}

    {%- if p_arr -%}
      {%- assign pn = p_arr | size -%}
      {%- if pn > 0 -%}
                {%- if is_steady -%}
                    {%- assign room = TIP_BUDGET -%}
        {%- else -%}
          {%- assign room = TIP_BUDGET | minus: temp_clause.size | minus: 1 -%}
        {%- endif -%}
        {%- assign start_at = local_days | plus: 3 | modulo: pn -%}
        {%- for probe in (0..11) -%}
          {%- if probe >= pn -%}{%- break -%}{%- endif -%}
          {%- assign try_at = start_at | plus: probe | modulo: pn -%}
          {%- assign candidate = p_arr[try_at] -%}
          {%- if candidate.size <= room -%}
            {%- assign precip_clause = candidate -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if precip_clause == '' -%}
          {%- assign shortest = 9999 -%}
          {%- for candidate in p_arr -%}
