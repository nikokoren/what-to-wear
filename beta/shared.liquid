    {%- endif -%}
  {%- endif -%}

    {%- assign temp_clause = temp_clause | replace: '{GARMENT}', garment_n -%}
  {%- assign temp_clause = temp_clause | replace: '{GARMENTA}', garment_a -%}
  {%- assign temp_clause = temp_clause | replace: '{WHEN2}', when_temp2 -%}
  {%- assign temp_clause = temp_clause | replace: '{WHEN}', when_temp -%}
  {%- assign temp_clause = temp_clause | replace: '  ', ' ' | strip -%}

    {%- if precip_scenario == 'wet_again' -%}
    {%- assign wa_lib_key = 'precip_' | append: sarcasm_level -%}
    {%- assign wa_lib = texts[wa_lib_key] -%}
    {%- unless wa_lib['wet_again'] -%}
      {%- assign precip_scenario = 'drier' -%}
    {%- endunless -%}
  {%- endif -%}

  {%- if precip_scenario != '' -%}
        {%- if is_steady -%}
      {%- assign p_key = precip_scenario -%}
    {%- else -%}
