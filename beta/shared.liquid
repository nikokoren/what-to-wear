{%- if today_md == '06-03' -%}{%- assign active_theme = 'bike' -%}{%- endif -%}
{%- if today_md >= '07-01' and today_md <= '07-23' -%}{%- assign active_theme = 'tdf' -%}{%- endif -%}
{%- if today_md >= '09-20' and today_md <= '10-05' -%}{%- assign active_theme = 'okt' -%}{%- endif -%}
{%- if today_md == '10-31' -%}{%- assign active_theme = 'spooky' -%}{%- endif -%}
{%- assign weekday_idx = local_days | plus: 4 | modulo: 7 -%}
{%- if today_md >= '11-22' and today_md <= '11-28' and weekday_idx == 4 -%}{%- assign active_theme = 'thanks' -%}{%- endif -%}
{%- if today_md == '12-05' -%}{%- assign active_theme = 'krampus' -%}{%- endif -%}
{%- if today_md == '12-06' -%}{%- assign active_theme = 'nikolo' -%}{%- endif -%}
{%- if today_md == '12-24' or today_md == '12-25' -%}{%- assign active_theme = 'xmas' -%}{%- endif -%}

