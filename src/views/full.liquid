{%- assign show_tip = false -%}
{%- if show_future_suggestions == 'on' and today_tip != '' -%}{%- assign show_tip = true -%}{%- endif -%}
<div class="layout layout--col layout--center">
  <div class="richtext richtext--center gap w--max-[100cqw]">
  {%- if is_error %}
    <img class="image image--contain h--[60cqh]" src="{{ sprite_url }}" alt="Error">
    <div class="content content--center text--center w--max-[100cqw] content--large lg:content--xlarge" data-content-limiter="true">
      <p>{{ error_message }}</p>
    </div>
  {%- else %}
    <img class="image image--contain image-dither {% if show_tip %}h--[60cqh]{% else %}h--[100cqh]{% endif %}"
      src="{{ sprite_url }}" onerror="this.onerror=null;this.src='{{ fallback_sprite_url }}'" alt="Outfit">
    {%- if show_tip %}
    <div class="content outfit-tip content--center text--center w--max-[100cqw] content--xlarge lg:content--xxlarge" data-content-limiter="true">
      <p>{{ today_tip }}</p>
    </div>
    {%- endif %}
  {%- endif %}
  </div>
</div>

{%- if show_bottom_bar == 'on' -%}
  <div class="title_bar">
    <span class="title">What to Wear</span>
    <span class="instance">{{ location_label }}</span>
  </div>
{%- endif -%}
