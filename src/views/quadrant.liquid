{%- assign show_tip = false -%}
{%- if show_future_suggestions == 'on' and today_tip != '' -%}{%- assign show_tip = true -%}{%- endif -%}
<div class="layout layout--row portrait:layout--col layout--center gap">
  {%- if is_error %}
    <img class="image image--contain h--[100cqh] w--max-[40cqw] portrait:h--[60cqh] portrait:w--max-[100cqw]" src="{{ sprite_url }}" alt="Error">
    <div class="content content--center text--center stretch-x content--large" data-content-limiter="true">
      <p>{{ error_headline }}</p>
    </div>
  {%- else %}
    <img class="image image--contain image-dither h--[100cqh] {% if show_tip %}w--max-[40cqw] portrait:h--[55cqh] portrait:w--max-[100cqw]{% endif %}"
      src="{{ sprite_url }}" onerror="this.onerror=null;this.src='{{ fallback_sprite_url }}'" alt="Outfit">
    {%- if show_tip %}
    <div class="content outfit-tip content--center text--center stretch-x content--base lg:content--large" data-content-limiter="true">
      <p>{{ today_tip }}</p>
    </div>
    {%- endif %}
  {%- endif %}
</div>

{%- if show_bottom_bar == 'on' -%}
  <div class="title_bar">
    <span class="title">What to Wear</span>
    <span class="instance">{{ location_label }}</span>
  </div>
{%- endif -%}
