{%- comment %}
WHAT TO WEAR, v3 - shared markup, TRANSITIONAL BUILD.

Generated by tools/build_transitional.py - do not hand edit.
Source of truth is src/shared.liquid plus lang/<code>.json.

Comments are stripped and the text libraries are inlined so this fits
under the 100 KB markup ceiling. Paste this in rollout step 1, then
src/shared.liquid in step 3. See docs/MIGRATION.md.
{%- endcomment %}
{%- assign MIN_DELTA = 2 -%}
{%- assign RAIN_LOW = 25 -%}
{%- assign RAIN_HIGH = 50 -%}
{%- assign DAY_END_HOUR = 21 -%}
{%- assign TIP_BUDGET = 165 -%}

{%- assign BAND_EDGES = '-7,3,10,14,19,27,32' -%}
{%- assign BAND_NAMES = 'extra_cold,freezing,cold,cool,mild,warm,hot,very_hot' -%}

{%- assign sprite_base_url  = 'https://raw.githubusercontent.com/nikokoren/what-to-wear/refs/heads/main/' -%}
{%- assign error_sprite_url = 'https://raw.githubusercontent.com/nikokoren/what-to-wear/refs/heads/main/404.png' -%}

{%- assign location_label_raw = trmnl.plugin_settings.custom_fields_values.location_label | default: '' -%}
{%- assign show_future_suggestions_raw = trmnl.plugin_settings.custom_fields_values.show_future_suggestions | default: 'yes' -%}
{%- assign language_raw = trmnl.plugin_settings.custom_fields_values.language | default: 'en' -%}
{%- assign sarcasm_level_raw = trmnl.plugin_settings.custom_fields_values.sarcasm_level | default: '10' -%}
{%- assign show_bottom_bar = trmnl.plugin_settings.custom_fields_values.show_bottom_bar | default: 'on' -%}
{%- assign temp_preference_raw = trmnl.plugin_settings.custom_fields_values.temp_preference | default: '0' -%}

{%- assign temp_shift = 0 -%}
{%- assign tp_check = temp_preference_raw | strip -%}
{%- if tp_check == '-4' or tp_check == '-2' or tp_check == '2' or tp_check == '4' -%}
  {%- assign temp_shift = tp_check | plus: 0 -%}
{%- endif -%}

{%- assign show_future_suggestions = 'on' -%}
{%- assign sfs_check = show_future_suggestions_raw | downcase | strip -%}
{%- if sfs_check == 'no' or sfs_check == 'false' or sfs_check == '0' -%}
  {%- assign show_future_suggestions = 'off' -%}
{%- endif -%}

{%- assign lang = language_raw | downcase | strip -%}
{%- if lang == '' -%}
  {%- assign lang = 'en' -%}
{%- endif -%}

{%- assign sarcasm_level = '0' -%}
{%- assign sarc_check = sarcasm_level_raw | strip -%}
{%- if sarc_check == '10' or sarc_check == '11' -%}
  {%- assign sarcasm_level = sarc_check -%}
{%- endif -%}

{%- assign location_label = location_label_raw -%}

{%- assign texts = nil -%}
{%- if IDX_0 -%}
  {%- assign cw = IDX_0.current -%}
  {%- assign h = IDX_0.hourly -%}
  {%- assign texts = IDX_1 -%}
{%- else -%}
  {%- assign cw = current -%}
  {%- assign h = hourly -%}
{%- endif -%}

{%- assign texts_ok = false -%}
{%- if texts.meta.code -%}
  {%- assign texts_ok = true -%}
{%- endif -%}

{%- assign now_time = cw.time -%}

{%- assign is_error = false -%}
{%- assign error_message = '' -%}
{%- assign error_headline = '' -%}

{%- if cw == nil -%}
  {%- assign is_error = true -%}
  {%- assign error_key = 'error_current' -%}
{%- elsif h == nil -%}
  {%- assign is_error = true -%}
  {%- assign error_key = 'error_hourly' -%}
{%- endif -%}

{%- assign has_location = false -%}
{%- assign lat_lon_set = trmnl.plugin_settings.custom_fields_values.lat_lon | default: '' | strip -%}
{%- assign latitude_set = trmnl.plugin_settings.custom_fields_values.latitude | default: '' | strip -%}
{%- if lat_lon_set != '' or latitude_set != '' -%}
  {%- assign has_location = true -%}
{%- endif -%}
{%- if is_error and has_location == false -%}
  {%- assign error_key = 'error_location' -%}
{%- endif -%}

{%- if is_error -%}
  {%- if texts_ok -%}
    {%- assign error_message = texts.ui[error_key] -%}
    {%- assign error_headline = texts.ui.error_short -%}
    {%- if error_key == 'error_location' and texts.ui.error_location_short -%}
      {%- assign error_headline = texts.ui.error_location_short -%}
    {%- endif -%}
  {%- endif -%}
    {%- if error_message == '' or error_message == nil -%}
    {%- if lang == 'de' -%}
      {%- if error_key == 'error_location' -%}
        {%- assign error_message = 'Kein Ort eingestellt. Öffne die Einstellungen und wähle einen aus.' -%}
        {%- assign error_headline = 'Kein Ort eingestellt' -%}
      {%- else -%}
        {%- if error_key == 'error_current' -%}
          {%- assign error_message = 'Wetterdaten konnten nicht abgerufen werden. Bitte versuche es später erneut.' -%}
        {%- else -%}
          {%- assign error_message = 'Wettervorhersage konnte nicht geladen werden. Bitte versuche es später erneut.' -%}
        {%- endif -%}
        {%- assign error_headline = 'Wetterdaten konnten nicht gelesen werden' -%}
      {%- endif -%}
    {%- else -%}
      {%- if error_key == 'error_location' -%}
        {%- assign error_message = 'No location set. Open this plugin’s settings and choose one.' -%}
        {%- assign error_headline = 'No location set' -%}
      {%- else -%}
        {%- if error_key == 'error_current' -%}
          {%- assign error_message = 'Unable to retrieve weather data. Please try again later.' -%}
        {%- else -%}
          {%- assign error_message = 'Unable to load forecast data. Please try again later.' -%}
        {%- endif -%}
        {%- assign error_headline = 'Could not read weather data' -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

{%- assign local_hour = 12 -%}
{%- assign today_md = '01-01' -%}

{%- if now_time -%}
  {%- assign local_hour = now_time | slice: 11, 2 | plus: 0 -%}
  {%- assign today_md = now_time | slice: 5, 5 -%}
{%- else -%}
  {%- assign epoch_utc0 = trmnl.system.timestamp_utc | default: 0 | plus: 0 -%}
  {%- assign utc_offset = trmnl.user.utc_offset | default: 0 | plus: 0 -%}
  {%- assign local_secs = epoch_utc0 | plus: utc_offset -%}
  {%- assign local_hour = local_secs | divided_by: 3600 | modulo: 24 -%}
  {%- assign today_md = local_secs | date: '%m-%d' -%}
{%- endif -%}

{%- assign epoch_utc = trmnl.system.timestamp_utc | default: 0 | plus: 0 -%}
{%- assign local_days = epoch_utc | divided_by: 86400 -%}

{%- assign dev_width = trmnl.device.width | plus: 0 -%}
{%- assign is_og = false -%}
{%- if dev_width <= 800 -%}
  {%- assign is_og = true -%}
{%- endif -%}

{%- assign RAIN_CODES = ',51,53,55,56,57,61,63,65,66,67,80,81,82,95,96,99,' -%}
{%- assign SNOW_CODES = ',71,73,75,77,85,86,' -%}

{%- assign temp_c = 0 -%}
{%- assign wmo = 0 -%}
{%- assign is_now_precip = 0 -%}
{%- assign is_now_snow = 0 -%}
{%- assign band = 'mild' -%}
{%- assign band_rank = 5 -%}
{%- assign weather_slug = '' -%}

{%- assign has_future_window = false -%}
{%- assign max_temp_future = 0 -%}
{%- assign min_temp_future = 0 -%}
{%- assign max_temp_idx = 0 -%}
{%- assign min_temp_idx = 0 -%}
{%- assign peak_rain = 0 -%}
{%- assign first_rain_idx = -1 -%}
{%- assign first_snow_idx = -1 -%}
{%- assign future_has_snow = false -%}
{%- assign rain_qualifies = false -%}
{%- assign peak_first = false -%}

{%- assign scenario = 'perfect' -%}
{%- assign temp_scenario = '' -%}
{%- assign precip_scenario = '' -%}
{%- assign when_temp = '' -%}
{%- assign when_temp2 = '' -%}
{%- assign when_precip = '' -%}
{%- assign when_temp_bucket = -1 -%}
{%- assign is_arc = false -%}
{%- assign garment_n = '' -%}
{%- assign garment_a = '' -%}
{%- assign when_same = false -%}

{%- if is_error == false -%}

  {%- assign temp_c = cw.apparent_temperature | default: 0 | plus: 0 -%}
  {%- assign wmo = cw.weather_code | default: 0 | plus: 0 -%}

  {%- assign wmo_probe = ',' | append: wmo | append: ',' -%}
  {%- if RAIN_CODES contains wmo_probe -%}
    {%- assign is_now_precip = 1 -%}
  {%- elsif SNOW_CODES contains wmo_probe -%}
    {%- assign is_now_precip = 1 -%}
    {%- assign is_now_snow = 1 -%}
  {%- endif -%}

    {%- assign band_edge_list = BAND_EDGES | split: ',' -%}
  {%- assign band_name_list = BAND_NAMES | split: ',' -%}

  {%- assign temp_banded = temp_c | plus: temp_shift -%}
  {%- assign band_rank = 8 -%}
  {%- for edge in band_edge_list -%}
    {%- assign edge_c = edge | plus: 0 -%}
    {%- if temp_banded <= edge_c -%}
      {%- assign band_rank = forloop.index -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign band_idx = band_rank | minus: 1 -%}
  {%- assign band = band_name_list[band_idx] -%}

    {%- assign precip_suffix = 'dry' -%}
  {%- if is_now_snow == 1 -%}
    {%- assign precip_suffix = 'snow' -%}
  {%- elsif is_now_precip == 1 -%}
    {%- assign precip_suffix = 'rain' -%}
  {%- endif -%}
  {%- assign weather_slug = band | append: '_' | append: precip_suffix -%}

    {%- assign now_index = -1 -%}
  {%- if now_time and h.time -%}
    {%- assign now_stamp = now_time | slice: 0, 13 -%}
    {%- for t in h.time -%}
      {%- if t contains now_stamp -%}
        {%- assign now_index = forloop.index0 -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if now_index < 0 -%}
    {%- assign now_index = local_hour -%}
  {%- endif -%}

    {%- assign cutoff_hour = DAY_END_HOUR -%}
  {%- assign min_cutoff = local_hour | plus: 3 -%}
  {%- if min_cutoff > cutoff_hour -%}
    {%- assign cutoff_hour = min_cutoff -%}
  {%- endif -%}
  {%- if cutoff_hour > 23 -%}
    {%- assign cutoff_hour = 23 -%}
  {%- endif -%}

  {%- assign temps = h.apparent_temperature -%}
  {%- assign probs = h.precipitation_probability -%}
  {%- assign codes = h.weather_code -%}

  {%- if temps != nil and probs != nil and cutoff_hour > local_hour -%}
    {%- assign h_count = temps | size | default: 0 -%}
    {%- assign last_index = h_count | minus: 1 -%}
    {%- assign span = cutoff_hour | minus: local_hour -%}
    {%- assign start_index = now_index | plus: 1 -%}
    {%- assign end_index = now_index | plus: span -%}
    {%- if end_index > last_index -%}
      {%- assign end_index = last_index -%}
    {%- endif -%}

    {%- if start_index <= end_index -%}
      {%- assign has_future_window = true -%}
      {%- assign max_temp_future = temp_c -%}
      {%- assign min_temp_future = temp_c -%}
      {%- assign max_temp_idx = start_index -%}
      {%- assign min_temp_idx = start_index -%}

      {%- for t in temps -%}
        {%- assign i = forloop.index0 -%}
        {%- if i >= start_index and i <= end_index -%}
          {%- assign tv = t | plus: 0 -%}
          {%- if tv > max_temp_future -%}
            {%- assign max_temp_future = tv -%}
            {%- assign max_temp_idx = i -%}
          {%- endif -%}
          {%- if tv < min_temp_future -%}
            {%- assign min_temp_future = tv -%}
            {%- assign min_temp_idx = i -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

            {%- assign run_len = 0 -%}
      {%- assign best_run = 0 -%}
      {%- for p in probs -%}
        {%- assign i = forloop.index0 -%}
        {%- if i >= start_index and i <= end_index -%}
          {%- assign pv = p | default: 0 | plus: 0 -%}
          {%- if pv > peak_rain -%}
            {%- assign peak_rain = pv -%}
          {%- endif -%}
          {%- if pv >= RAIN_LOW -%}
            {%- assign run_len = run_len | plus: 1 -%}
            {%- if run_len > best_run -%}
              {%- assign best_run = run_len -%}
            {%- endif -%}
            {%- if first_rain_idx < 0 -%}
              {%- assign first_rain_idx = i -%}
            {%- endif -%}
          {%- else -%}
            {%- assign run_len = 0 -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if best_run >= 2 or peak_rain >= RAIN_HIGH -%}
        {%- assign rain_qualifies = true -%}
      {%- endif -%}

            {%- if codes != nil -%}
        {%- for c in codes -%}
          {%- assign i = forloop.index0 -%}
          {%- if i >= start_index and i <= end_index -%}
            {%- assign c_probe = ',' | append: c | append: ',' -%}
            {%- if SNOW_CODES contains c_probe -%}
              {%- assign future_has_snow = true -%}
              {%- if first_snow_idx < 0 -%}
                {%- assign first_snow_idx = i -%}
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}

  {%- if has_future_window -%}

        {%- assign delta_up = max_temp_future | minus: temp_c -%}
    {%- if max_temp_idx <= min_temp_idx -%}
      {%- assign delta_down = max_temp_future | minus: min_temp_future -%}
      {%- assign peak_first = true -%}
    {%- else -%}
      {%- assign delta_down = temp_c | minus: min_temp_future -%}
      {%- assign peak_first = false -%}
    {%- endif -%}

        {%- assign max_banded = max_temp_future | plus: temp_shift -%}
    {%- assign up_rank = 8 -%}
    {%- for edge in band_edge_list -%}
      {%- assign edge_c = edge | plus: 0 -%}
      {%- if max_banded <= edge_c -%}
        {%- assign up_rank = forloop.index -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- assign min_banded = min_temp_future | plus: temp_shift -%}
    {%- assign down_rank = 8 -%}
    {%- for edge in band_edge_list -%}
      {%- assign edge_c = edge | plus: 0 -%}
      {%- if min_banded <= edge_c -%}
        {%- assign down_rank = forloop.index -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

        {%- if texts_ok -%}
      {%- assign GARMENTS_N = texts.garments.n -%}
      {%- assign GARMENTS_A = texts.garments.a -%}
    {%- elsif lang == 'en' -%}
      {%- assign GARMENTS_N = 'The scarf,The coat,The jacket,The hoodie,The sweatshirt' | split: ',' -%}
      {%- assign GARMENTS_A = 'the scarf,the coat,the jacket,the hoodie,the sweatshirt' | split: ',' -%}
    {%- elsif lang == 'de' -%}
      {%- assign GARMENTS_N = 'Der Schal,Die Winterjacke,Die Jacke,Der Hoodie,Der Pulli' | split: ',' -%}
      {%- assign GARMENTS_A = 'den Schal,die Winterjacke,die Jacke,den Hoodie,den Pulli' | split: ',' -%}
    {%- else -%}
      {%- assign GARMENTS_N = 'The scarf,The coat,The jacket,The hoodie,The sweatshirt' | split: ',' -%}
      {%- assign GARMENTS_A = 'the scarf,the coat,the jacket,the hoodie,the sweatshirt' | split: ',' -%}
    {%- endif -%}
    {%- assign WKEYS = 'w_scarf,w_coat,w_jacket,w_hoodie,w_sweatshirt' | split: ',' -%}
    {%- assign CKEYS = 'c_scarf,c_coat,c_jacket,c_hoodie,c_sweatshirt' | split: ',' -%}

        {%- assign garment_n = '' -%}
    {%- assign garment_a = '' -%}
    {%- if band_rank <= 5 -%}
      {%- assign gi = band_rank | minus: 1 -%}
      {%- assign garment_n = GARMENTS_N[gi] -%}
      {%- assign garment_a = GARMENTS_A[gi] -%}
    {%- endif -%}

        {%- assign warm_key = '' -%}
    {%- assign warm_removable = false -%}
    {%- if delta_up >= MIN_DELTA and up_rank > band_rank -%}
      {%- assign same_class = false -%}
      {%- if band_rank >= 4 and band_rank <= 5 and up_rank >= 4 and up_rank <= 5 -%}
        {%- assign same_class = true -%}
      {%- endif -%}
      {%- unless same_class -%}
        {%- if band_rank <= 5 -%}
          {%- assign wi = band_rank | minus: 1 -%}
          {%- assign warm_key = WKEYS[wi] -%}
          {%- assign warm_removable = true -%}
        {%- elsif up_rank >= 7 -%}
                    {%- assign warm_key = 'w_water' -%}
        {%- endif -%}
      {%- endunless -%}
    {%- endif -%}

        {%- assign cold_key = '' -%}
    {%- if peak_first -%}
      {%- assign from_rank = up_rank -%}
    {%- else -%}
      {%- assign from_rank = band_rank -%}
    {%- endif -%}
    {%- if delta_down >= MIN_DELTA and down_rank < from_rank -%}
      {%- assign same_class = false -%}
      {%- if down_rank >= 4 and down_rank <= 5 and from_rank >= 4 and from_rank <= 5 -%}
        {%- assign same_class = true -%}
      {%- endif -%}
      {%- unless same_class -%}
        {%- if down_rank <= 5 -%}
          {%- assign ci = down_rank | minus: 1 -%}
          {%- assign cold_key = CKEYS[ci] -%}
        {%- else -%}
          {%- assign cold_key = 'c_relief' -%}
        {%- endif -%}
      {%- endunless -%}
    {%- endif -%}

        {%- assign primary_idx = 0 -%}
    {%- assign secondary_idx = 0 -%}

    {%- if warm_removable and cold_key != '' and peak_first -%}
      {%- if down_rank < band_rank -%}
        {%- assign temp_scenario = 'arc_colder' -%}
      {%- elsif down_rank > band_rank -%}
        {%- assign temp_scenario = 'arc_warmer' -%}
      {%- else -%}
        {%- assign temp_scenario = 'arc_level' -%}
      {%- endif -%}
      {%- assign primary_idx = max_temp_idx -%}
      {%- assign secondary_idx = min_temp_idx -%}
    {%- elsif cold_key != '' -%}
      {%- assign temp_scenario = cold_key -%}
      {%- assign primary_idx = min_temp_idx -%}
    {%- elsif warm_key != '' -%}
      {%- assign temp_scenario = warm_key -%}
      {%- assign primary_idx = max_temp_idx -%}
    {%- endif -%}

    {%- assign is_arc = false -%}
    {%- if temp_scenario contains 'arc' -%}
      {%- assign is_arc = true -%}
    {%- endif -%}

        {%- assign precip_idx = 0 -%}
    {%- if future_has_snow and is_now_snow == 0 -%}
      {%- assign precip_scenario = 'snow_coming' -%}
      {%- assign precip_idx = first_snow_idx -%}
    {%- elsif is_now_precip == 0 and rain_qualifies -%}
      {%- if peak_rain < 60 -%}
        {%- assign precip_scenario = 'wetter_maybe' -%}
      {%- elsif best_run >= 4 -%}
        {%- assign precip_scenario = 'wetter_long' -%}
      {%- else -%}
        {%- assign precip_scenario = 'wetter' -%}
      {%- endif -%}
      {%- assign precip_idx = first_rain_idx -%}
    {%- elsif is_now_precip == 1 and rain_qualifies == false -%}
      {%- assign precip_scenario = 'drier' -%}
      {%- assign precip_idx = start_index -%}
    {%- elsif is_now_precip == 1 and rain_qualifies -%}
      {%- assign precip_scenario = 'stays_wet' -%}
      {%- assign precip_idx = end_index -%}
    {%- endif -%}

        {%- if texts_ok -%}
      {%- assign BUCKETS = texts.buckets -%}
      {%- assign RELATIVE = texts.relative -%}
    {%- elsif lang == 'en' -%}
      {%- assign BUCKETS = 'this morning,around midday,this afternoon,this evening,tonight' | split: ',' -%}
      {%- assign RELATIVE = 'in an hour,in two hours,in three hours' | split: ',' -%}
    {%- elsif lang == 'de' -%}
      {%- assign BUCKETS = 'heute Vormittag,gegen Mittag,heute Nachmittag,heute Abend,heute Nacht' | split: ',' -%}
      {%- assign RELATIVE = 'in einer Stunde,in zwei Stunden,in drei Stunden' | split: ',' -%}
    {%- else -%}
      {%- assign BUCKETS = 'this morning,around midday,this afternoon,this evening,tonight' | split: ',' -%}
      {%- assign RELATIVE = 'in an hour,in two hours,in three hours' | split: ',' -%}
    {%- endif -%}

    {%- if local_hour < 11 -%}{%- assign now_bucket = 0 -%}
    {%- elsif local_hour < 14 -%}{%- assign now_bucket = 1 -%}
    {%- elsif local_hour < 17 -%}{%- assign now_bucket = 2 -%}
    {%- elsif local_hour < 20 -%}{%- assign now_bucket = 3 -%}
    {%- else -%}{%- assign now_bucket = 4 -%}{%- endif -%}

        {%- if temp_scenario != '' -%}
      {%- assign gap = primary_idx | minus: now_index -%}
      {%- assign th = local_hour | plus: gap -%}
      {%- if th > 23 -%}{%- assign th = 23 -%}{%- endif -%}
      {%- if th < 11 -%}{%- assign tb = 0 -%}
      {%- elsif th < 14 -%}{%- assign tb = 1 -%}
      {%- elsif th < 17 -%}{%- assign tb = 2 -%}
      {%- elsif th < 20 -%}{%- assign tb = 3 -%}
      {%- else -%}{%- assign tb = 4 -%}{%- endif -%}
      {%- assign when_temp_bucket = tb -%}
      {%- if tb == now_bucket and gap >= 1 and gap <= 3 and is_arc == false -%}
        {%- assign gi = gap | minus: 1 -%}
        {%- assign when_temp = RELATIVE[gi] -%}
      {%- else -%}
        {%- assign when_temp = BUCKETS[tb] -%}
      {%- endif -%}
    {%- endif -%}

        {%- if is_arc -%}
      {%- assign gap2 = secondary_idx | minus: now_index -%}
      {%- assign th2 = local_hour | plus: gap2 -%}
      {%- if th2 > 23 -%}{%- assign th2 = 23 -%}{%- endif -%}
      {%- if th2 < 11 -%}{%- assign tb2 = 0 -%}
      {%- elsif th2 < 14 -%}{%- assign tb2 = 1 -%}
      {%- elsif th2 < 17 -%}{%- assign tb2 = 2 -%}
      {%- elsif th2 < 20 -%}{%- assign tb2 = 3 -%}
      {%- else -%}{%- assign tb2 = 4 -%}{%- endif -%}
            {%- if tb2 == when_temp_bucket -%}
        {%- if when_temp_bucket < 4 -%}
          {%- assign when_temp2 = BUCKETS[4] -%}
        {%- else -%}
          {%- assign when_temp2 = '' -%}
        {%- endif -%}
      {%- else -%}
        {%- assign when_temp2 = BUCKETS[tb2] -%}
      {%- endif -%}
    {%- endif -%}

        {%- assign wants_whenp = false -%}
