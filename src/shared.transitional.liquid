    {%- assign t_entries = temp_lib | split: ';;' -%}
    {%- for e in t_entries -%}
      {%- assign parts = e | strip | split: '::' -%}
      {%- if parts[0] == scenario -%}
        {%- assign t_arr = parts[1] | split: '||' -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  {%- if t_arr -%}
    {%- assign n = t_arr | size -%}
    {%- if n > 0 -%}
      {%- assign idx = local_days | modulo: n -%}
      {%- assign temp_clause = t_arr[idx] -%}
            {%- assign need_plain = false -%}
      {%- if when_temp == '' or when_temp == nil -%}
        {%- assign need_plain = true -%}
      {%- endif -%}
      {%- if is_arc and when_temp2 == '' -%}
        {%- assign need_plain = true -%}
      {%- endif -%}
      {%- if need_plain and temp_clause contains '{WHEN' -%}
        {%- for line in t_arr -%}
          {%- unless line contains '{WHEN' -%}
            {%- assign temp_clause = line -%}
            {%- break -%}
          {%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}

    {%- assign temp_clause = temp_clause | replace: '{GARMENT}', garment_n -%}
  {%- assign temp_clause = temp_clause | replace: '{GARMENTA}', garment_a -%}
  {%- assign temp_clause = temp_clause | replace: '{WHEN2}', when_temp2 -%}
  {%- assign temp_clause = temp_clause | replace: '{WHEN}', when_temp -%}
  {%- assign temp_clause = temp_clause | replace: '  ', ' ' | strip -%}

  {%- if precip_scenario != '' -%}
        {%- if is_steady -%}
      {%- assign p_key = precip_scenario -%}
    {%- else -%}
      {%- assign p_key = precip_scenario | append: '_j' -%}
    {%- endif -%}

    {%- assign precip_lib_key = 'precip_' | append: sarcasm_level -%}
    {%- assign p_arr = nil -%}
    {%- if texts_ok -%}
      {%- assign precip_lib = texts[precip_lib_key] -%}
      {%- assign p_arr = precip_lib[p_key] -%}
    {%- else -%}
      {%- assign embedded_key = precip_lib_key | append: '_' | append: lang -%}
      {%- case embedded_key -%}
        {%- when 'precip_0_en' -%}{%- assign precip_lib = precip_0_en -%}
        {%- when 'precip_10_en' -%}{%- assign precip_lib = precip_10_en -%}
        {%- when 'precip_11_en' -%}{%- assign precip_lib = precip_11_en -%}
        {%- when 'precip_0_de' -%}{%- assign precip_lib = precip_0_de -%}
        {%- when 'precip_10_de' -%}{%- assign precip_lib = precip_10_de -%}
        {%- when 'precip_11_de' -%}{%- assign precip_lib = precip_11_de -%}
        {%- else -%}{%- assign precip_lib = precip_0_en -%}
      {%- endcase -%}
      {%- assign p_entries = precip_lib | split: ';;' -%}
      {%- for e in p_entries -%}
        {%- assign parts = e | strip | split: '::' -%}
        {%- if parts[0] == p_key -%}
          {%- assign p_arr = parts[1] | split: '||' -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}

    {%- if p_arr -%}
      {%- assign pn = p_arr | size -%}
      {%- if pn > 0 -%}
                {%- if is_steady -%}
                    {%- assign room = TIP_BUDGET -%}
        {%- else -%}
          {%- assign room = TIP_BUDGET | minus: temp_clause.size | minus: 1 -%}
        {%- endif -%}
        {%- assign start_at = local_days | plus: 3 | modulo: pn -%}
        {%- for probe in (0..11) -%}
          {%- if probe >= pn -%}{%- break -%}{%- endif -%}
          {%- assign try_at = start_at | plus: probe | modulo: pn -%}
          {%- assign candidate = p_arr[try_at] -%}
          {%- if candidate.size <= room -%}
            {%- assign precip_clause = candidate -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if precip_clause == '' -%}
          {%- assign shortest = 9999 -%}
          {%- for candidate in p_arr -%}
            {%- if candidate.size < shortest -%}
              {%- assign shortest = candidate.size -%}
              {%- assign precip_clause = candidate -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

        {%- assign precip_clause = precip_clause | replace: '{WHENP}', when_precip -%}
        {%- assign precip_clause = precip_clause | replace: '  ', ' ' | strip -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}

  {%- if is_steady and precip_clause != '' -%}
    {%- assign today_tip = precip_clause -%}
  {%- elsif precip_clause != '' -%}
    {%- assign today_tip = temp_clause | append: ' ' | append: precip_clause -%}
  {%- else -%}
    {%- assign today_tip = temp_clause -%}
  {%- endif -%}

  {%- assign today_tip = today_tip | strip -%}

    {%- assign sentences = today_tip | split: '. ' -%}
  {%- assign cased = '' -%}
  {%- for sentence in sentences -%}
    {%- assign head = sentence | slice: 0 | upcase -%}
    {%- assign tail = sentence | slice: 1, 400 -%}
    {%- if forloop.first -%}
      {%- assign cased = head | append: tail -%}
    {%- else -%}
      {%- assign cased = cased | append: '. ' | append: head | append: tail -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if cased != '' -%}
    {%- assign today_tip = cased -%}
  {%- endif -%}

{%- endif -%}

{%- if weather_slug == 'very_hot_rain' -%}
  {%- assign weather_slug = 'hot_rain' -%}
{%- elsif weather_slug == 'very_hot_snow' or weather_slug == 'hot_snow' or weather_slug == 'warm_snow' or weather_slug == 'mild_snow' or weather_slug == 'cool_snow' or weather_slug == 'cold_snow' -%}
  {%- assign weather_slug = 'freezing_snow' -%}
{%- elsif weather_slug == 'extra_cold_rain' -%}
  {%- assign weather_slug = 'extra_cold_snow' -%}
{%- endif -%}
{%- if weather_slug == 'extra_cold_dry' -%}{%- assign weather_slug = 'freezing_dry' -%}{%- endif -%}
{%- if weather_slug == 'extra_cold_snow' -%}{%- assign weather_slug = 'freezing_snow' -%}{%- endif -%}
{%- if weather_slug == 'freezing_rain' -%}{%- assign weather_slug = 'freezing_dry' -%}{%- endif -%}

{%- assign sprite_slug = weather_slug -%}
{%- if active_theme != '' and is_error == false -%}
  {%- assign slug_probe = ',' | append: weather_slug | append: ',' -%}
  {%- if theme_whitelist == 'ALL' or theme_whitelist contains slug_probe -%}
    {%- assign sprite_slug = active_theme | append: '_' | append: weather_slug -%}
  {%- endif -%}
{%- endif -%}

{%- if is_error -%}
  {%- assign sprite_url = error_sprite_url -%}
  {%- assign fallback_sprite_url = error_sprite_url -%}
{%- else -%}
  {%- assign sprite_url = sprite_base_url | append: sprite_slug | append: '.png' -%}
    {%- assign fallback_sprite_url = sprite_base_url | append: weather_slug | append: '.png' -%}
{%- endif -%}
